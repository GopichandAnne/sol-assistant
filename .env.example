# ─────────────────────────────────────────────────────────────────────────────
# The Assistant, by Sol Consulting. Console environment contract.
# Copy to `.env.local` and fill in. `.env.local` is gitignored. No real values
# belong in this file.
#
# Supabase project: sol-assistant (sngmxemsfhtkaxwgkwfy)
#
# ON VERCEL, THE VARIABLE *TYPE* MATTERS AS MUCH AS THE VALUE:
#   • NEXT_PUBLIC_* must be type "Config", never "Secret". Next.js compiles these
#     into the bundle at BUILD time, and Vercel Secrets are decrypted at runtime
#     only. A NEXT_PUBLIC_ variable saved as Secret builds as `undefined`, and the
#     middleware then throws "Your project's URL and Key are required" on every
#     request, so the whole site returns 500.
#   • SUPABASE_INTERNAL_URL is bundled into middleware at build time too, so it
#     also has to be Config. It is only a hostname, not a secret.
#   • SUPABASE_SERVICE_ROLE_KEY is read at runtime by server code, so Secret is
#     both safe and correct for it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required. The console will not boot without these. ───────────────────────

# Supabase project URL. Dashboard → Project Settings → Data API. Type: Config.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Same page. Safe in the browser: it ships in
# the client bundle by design, and RLS is what protects data, not this key.
# Type: Config.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY. Type: Secret.
#   - NEVER prefix with NEXT_PUBLIC.
#   - NEVER import into a client component.
#   - Bypasses RLS. Used by server actions and the admin client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Strongly recommended ─────────────────────────────────────────────────────

# This console's own public URL. Several routes fall back to the upstream
# product's domain when this is unset, which would send your users elsewhere.
# Type: Config.
NEXT_PUBLIC_APP_URL=

# Direct *.supabase.co host for server-side auth calls. Only matters once a
# Supabase custom domain is in play: the custom domain adds roughly 1.5s to every
# server-side getUser() from Vercel, while the browser keeps the custom domain.
# Type: Config.
SUPABASE_INTERNAL_URL=

# Where the embeddable chat is served from, for the in-console assistant bubble.
NEXT_PUBLIC_AGENT_URL=

# Show the "Continue with Microsoft" button on the sign-in page. Set to "true"
# ONLY after the Azure provider is enabled in Supabase Auth, or the button appears
# and can only fail. Entra is the intended front door for staff: they are already
# signed in to Microsoft, so it is one click and no password. Email and password
# stays as the break-glass path.
#
# NOT NEXT_PUBLIC_, on purpose. This is read server-side at request time, so it
# works whether Vercel stores it as Config or Secret, and toggling it needs no
# rebuild. A NEXT_PUBLIC_ flag stored as a Secret reads as undefined at build time
# and the feature stays silently off on a green deployment.
# (NEXT_PUBLIC_MICROSOFT_SSO is still honoured if already set.)
MICROSOFT_SSO=

# ── Optional ─────────────────────────────────────────────────────────────────

# Shared secret for the onboarding site-detect endpoint.
WEB_DETECT_SECRET=

# Outbound email, as SUPABASE FUNCTION secrets (not Vercel). Without these the
# low-credit warning detects the crossing and sends nothing; everything else works.
# Microsoft 365:    SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Google Workspace: SMTP_HOST=smtp.gmail.com      SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Slack front door (only if you connect Slack).
SLACK_CLIENT_ID=
SLACK_STATE_SECRET=
SLACK_REDIRECT_URL=

# Microsoft Teams front door (only if you connect Teams).
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# ── Not used by this product ─────────────────────────────────────────────────
# The upstream platform this forked from also carried Stripe, POS connectors
# (Square / Clover / Toast / Lightspeed), WhatsApp and Ask Rani Insights. None of
# those are wired here: Stripe was removed outright because it credited a retired
# wallet, and the rest sit dormant behind a console profile that is pinned to
# "saas". If you find yourself setting one of those, check whether you actually
# want it before reviving the code path behind it.
#
# Note that credits are GRANTED in this product, from /admin/companies. There is
# no payment processor, so no processor keys belong here.
